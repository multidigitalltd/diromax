<?xml version="1.0"?>
<!--
	Full suite: unit tests plus WordPress integration tests against a real
	MySQL test database (it is wiped on every run — never point it at real data).

	Database settings come from the environment, with local defaults:
	  WP_TESTS_DB_NAME=wp_tests  WP_TESTS_DB_USER=wp  WP_TESTS_DB_PASSWORD=wp  WP_TESTS_DB_HOST=127.0.0.1
-->
<phpunit
	bootstrap="diromax-portal/tests/bootstrap.php"
	colors="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	failOnRisky="true"
	failOnWarning="true"
	convertDeprecationsToExceptions="true"
>
	<php>
		<!-- The plugin's structured log goes to error_log; keep it out of the test output. -->
		<ini name="error_log" value="/dev/null"/>
	</php>
	<testsuites>
		<testsuite name="unit">
			<directory suffix="Test.php">diromax-portal/tests/Unit</directory>
		</testsuite>
		<testsuite name="integration">
			<directory suffix="Test.php">diromax-portal/tests/Integration</directory>
		</testsuite>
	</testsuites>
	<coverage>
		<include>
			<directory suffix=".php">diromax-portal/src</directory>
		</include>
	</coverage>
</phpunit>
